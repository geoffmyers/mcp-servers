# Example configuration. Copy to .env and fill in your own values.
# Angle-bracket values are placeholders; replace them.
# ESPHome CLI MCP Server Configuration
# EXECUTION_MODE: "local" runs `docker exec` directly on the host that owns
#                  the ESPHome container; "ssh" runs `docker exec` over SSH on
#                  SSH_HOST (e.g. when the MCP server runs on a different host).
EXECUTION_MODE=local
# Standalone docker-compose deployment (current setup):
#   container name `esphome`, in-container config path `/config`.
# Legacy HAOS add-on deployment override:
#   EXECUTION_MODE=ssh
#   SSH_HOST=<your-ssh-host>
#   ESPHOME_CONTAINER=addon_5c53de3b_esphome
#   ESPHOME_CONFIG_DIR=/config/esphome
ESPHOME_CONFIG_DIR=/config
ESPHOME_CONTAINER=esphome
