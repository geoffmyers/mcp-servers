# Example configuration. Copy to .env and fill in your own values.
# Angle-bracket values are placeholders; replace them.
# Markdown RAG MCP Server — environment template

# Qdrant vector store (same .env works from any LAN host)
QDRANT_URL=<your-qdrant-url>
QDRANT_API_KEY=<your-api-key>
QDRANT_COLLECTION=markdown_kb

# Ollama embedding host (same .env works from any LAN host)
OLLAMA_URL=<your-ollama-url>
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
