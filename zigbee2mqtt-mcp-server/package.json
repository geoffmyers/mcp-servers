{
  "name": "@geoffmyers/mcp-server-zigbee2mqtt",
  "version": "1.0.0",
  "description": "MCP server for Zigbee2MQTT (MQTT + Docker container management)",
  "engines": {
    "node": ">=20.6"
  },
  "license": "GPL-3.0-or-later",
  "author": "Geoff Myers",
  "type": "module",
  "bin": {
    "mcp-server-zigbee2mqtt": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && shx mkdir -p dist/docs && shx cp -r docs/* dist/docs/ && shx chmod +x dist/index.js",
    "watch": "tsc --watch",
    "start:stdio": "node dist/index.js stdio",
    "start:streamableHttp": "node dist/index.js streamableHttp"
  },
  "dependencies": {
    "@geoffmyers/mcp-server-shared": "file:../mcp-server-shared",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "mqtt": "^5.15.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "shx": "^0.3.4",
    "typescript": "^5.6.2"
  }
}
