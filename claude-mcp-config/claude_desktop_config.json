{
  "mcpServers": {
    "brave-search": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/brave-search-mcp"],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      }
    },
    "cloudflare": {
      "command": "npx",
      "args": ["-y", "@cloudflare/mcp-server-cloudflare"],
      "env": {
        "CLOUDFLARE_API_TOKEN": "${CLOUDFLARE_API_TOKEN}",
        "CLOUDFLARE_ACCOUNT_ID": "${CLOUDFLARE_ACCOUNT_ID}"
      }
    },
    "docker": {
      "command": "npx",
      "args": ["-y", "@docker/mcp-hub"],
      "env": {
        "DOCKER_HUB_USERNAME": "${DOCKER_HUB_USERNAME}",
        "DOCKER_HUB_PAT": "${DOCKER_HUB_PAT}"
      }
    },
    "dropbox": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/dropbox-mcp"],
      "env": {
        "DROPBOX_ACCESS_TOKEN": "${DROPBOX_ACCESS_TOKEN}"
      }
    },
    "freshbooks": {
      "command": "npx",
      "args": ["-y", "freshbooks-mcp"],
      "env": {
        "FRESHBOOKS_CLIENT_ID": "${FRESHBOOKS_CLIENT_ID}",
        "FRESHBOOKS_CLIENT_SECRET": "${FRESHBOOKS_CLIENT_SECRET}",
        "FRESHBOOKS_REDIRECT_URI": "${FRESHBOOKS_REDIRECT_URI}",
        "FRESHBOOKS_ACCOUNT_ID": "${FRESHBOOKS_ACCOUNT_ID}"
      }
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "gmail": {
      "command": "npx",
      "args": ["-y", "@gongrzhe/server-gmail-autoauth-mcp"],
      "env": {
        "GMAIL_OAUTH_CLIENT_ID": "${GMAIL_OAUTH_CLIENT_ID}",
        "GMAIL_OAUTH_CLIENT_SECRET": "${GMAIL_OAUTH_CLIENT_SECRET}"
      }
    },
    "google-calendar": {
      "command": "npx",
      "args": ["-y", "@cocal/google-calendar-mcp"],
      "env": {
        "GOOGLE_OAUTH_CLIENT_ID": "${GOOGLE_OAUTH_CLIENT_ID}",
        "GOOGLE_OAUTH_CLIENT_SECRET": "${GOOGLE_OAUTH_CLIENT_SECRET}"
      }
    },
    "google-chrome": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp"],
      "env": {
        "CHROME_DEBUG_PORT": "${CHROME_DEBUG_PORT:-9222}"
      }
    },
    "google-drive": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-gdrive"],
      "env": {
        "GOOGLE_OAUTH_CLIENT_ID": "${GOOGLE_OAUTH_CLIENT_ID}",
        "GOOGLE_OAUTH_CLIENT_SECRET": "${GOOGLE_OAUTH_CLIENT_SECRET}"
      }
    },
    "gravity-forms": {
      "command": "npx",
      "args": ["-y", "@gravitykit/gravitymcp"],
      "env": {
        "GRAVITY_FORMS_SITE_URL": "${GRAVITY_FORMS_SITE_URL}",
        "GRAVITY_FORMS_API_KEY": "${GRAVITY_FORMS_API_KEY}",
        "GRAVITY_FORMS_PRIVATE_KEY": "${GRAVITY_FORMS_PRIVATE_KEY}"
      }
    },
    "home-assistant": {
      "command": "uvx",
      "args": ["mcp-server-home-assistant"],
      "env": {
        "HOME_ASSISTANT_WEB_SOCKET_URL": "${HOME_ASSISTANT_WEB_SOCKET_URL}",
        "HOME_ASSISTANT_API_TOKEN": "${HOME_ASSISTANT_API_TOKEN}"
      }
    },
    "hubspot": {
      "command": "npx",
      "args": ["-y", "@hubspot/mcp-server"],
      "env": {
        "HUBSPOT_PRIVATE_APP_TOKEN": "${HUBSPOT_PRIVATE_APP_TOKEN}"
      }
    },
    "make": {
      "command": "npx",
      "args": ["-y", "@makehq/mcp-server"],
      "env": {
        "MAKE_API_KEY": "${MAKE_API_KEY}",
        "MAKE_ZONE": "${MAKE_ZONE:-us1}",
        "MAKE_TEAM_ID": "${MAKE_TEAM_ID}"
      }
    },
    "mermaid": {
      "command": "npx",
      "args": ["-y", "@peng-shawn/mermaid-mcp-server"]
    },
    "monarch-money": {
      "command": "uvx",
      "args": ["monarch-money-mcp"],
      "env": {
        "MONARCH_EMAIL": "${MONARCH_EMAIL}",
        "MONARCH_PASSWORD": "${MONARCH_PASSWORD}"
      }
    },
    "n8n": {
      "command": "npx",
      "args": ["-y", "n8n-mcp-server"],
      "env": {
        "N8N_API_KEY": "${N8N_API_KEY}",
        "N8N_BASE_URL": "${N8N_BASE_URL}"
      }
    },
    "notion": {
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server"],
      "env": {
        "NOTION_API_KEY": "${NOTION_API_KEY}"
      }
    },
    "pfsense": {
      "command": "uvx",
      "args": ["pfsense-mcp-server"],
      "env": {
        "PFSENSE_HOST": "${PFSENSE_HOST}",
        "PFSENSE_USERNAME": "${PFSENSE_USERNAME}",
        "PFSENSE_PASSWORD": "${PFSENSE_PASSWORD}",
        "PFSENSE_VERIFY_SSL": "${PFSENSE_VERIFY_SSL:-false}"
      }
    },
    "plex": {
      "command": "npx",
      "args": ["-y", "plex-mcp"],
      "env": {
        "PLEX_URL": "${PLEX_URL}",
        "PLEX_TOKEN": "${PLEX_TOKEN}"
      }
    },
    "portainer": {
      "command": "npx",
      "args": ["-y", "portainer-mcp"],
      "env": {
        "PORTAINER_URL": "${PORTAINER_URL}",
        "PORTAINER_API_KEY": "${PORTAINER_API_KEY}"
      }
    },
    "sentry": {
      "command": "npx",
      "args": ["-y", "@sentry/mcp-server"],
      "env": {
        "SENTRY_AUTH_TOKEN": "${SENTRY_AUTH_TOKEN}",
        "SENTRY_ORGANIZATION": "${SENTRY_ORGANIZATION}"
      }
    },
    "stripe": {
      "command": "npx",
      "args": ["-y", "@stripe/mcp", "--tools=all"],
      "env": {
        "STRIPE_SECRET_KEY": "${STRIPE_SECRET_KEY}"
      }
    },
    "todoist": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/todoist-mcp"],
      "env": {
        "TODOIST_API_TOKEN": "${TODOIST_API_TOKEN}"
      }
    },
    "trello": {
      "command": "npx",
      "args": ["-y", "@delorenj/mcp-server-trello"],
      "env": {
        "TRELLO_API_KEY": "${TRELLO_API_KEY}",
        "TRELLO_API_TOKEN": "${TRELLO_API_TOKEN}"
      }
    },
    "truenas": {
      "command": "uvx",
      "args": ["truenas-mcp-server"],
      "env": {
        "TRUENAS_HOST": "${TRUENAS_HOST}",
        "TRUENAS_API_KEY": "${TRUENAS_API_KEY}"
      }
    },
    "unifi": {
      "command": "npx",
      "args": ["-y", "@thelord/unifi-mcp-server"],
      "env": {
        "UNIFI_HOST": "${UNIFI_HOST}",
        "UNIFI_USERNAME": "${UNIFI_USERNAME}",
        "UNIFI_PASSWORD": "${UNIFI_PASSWORD}",
        "UNIFI_SITE": "${UNIFI_SITE:-default}"
      }
    },
    "woocommerce": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/woocommerce-mcp"],
      "env": {
        "WOOCOMMERCE_URL": "${WOOCOMMERCE_URL}",
        "WOOCOMMERCE_CONSUMER_KEY": "${WOOCOMMERCE_CONSUMER_KEY}",
        "WOOCOMMERCE_CONSUMER_SECRET": "${WOOCOMMERCE_CONSUMER_SECRET}"
      }
    },
    "wordpress": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/wordpress-mcp"],
      "env": {
        "WORDPRESS_URL": "${WORDPRESS_URL}",
        "WORDPRESS_USERNAME": "${WORDPRESS_USERNAME}",
        "WORDPRESS_APPLICATION_PASSWORD": "${WORDPRESS_APPLICATION_PASSWORD}"
      }
    },
    "1password": {
      "command": "npx",
      "args": ["-y", "@1password/mcp-server"],
      "env": {
        "OP_SERVICE_ACCOUNT_TOKEN": "${OP_SERVICE_ACCOUNT_TOKEN}"
      }
    },
    "amazon-shopping": {
      "command": "npx",
      "args": ["-y", "mcp-server-amazon"],
      "env": {
        "AMAZON_EMAIL": "${AMAZON_EMAIL}",
        "AMAZON_PASSWORD": "${AMAZON_PASSWORD}"
      }
    },
    "aws": {
      "command": "uvx",
      "args": ["awslabs.aws-mcp-servers.core"],
      "env": {
        "AWS_ACCESS_KEY_ID": "${AWS_ACCESS_KEY_ID}",
        "AWS_SECRET_ACCESS_KEY": "${AWS_SECRET_ACCESS_KEY}",
        "AWS_REGION": "${AWS_REGION:-us-east-1}"
      }
    },
    "ebay": {
      "command": "npx",
      "args": ["-y", "ebay-mcp"],
      "env": {
        "EBAY_CLIENT_ID": "${EBAY_CLIENT_ID}",
        "EBAY_CLIENT_SECRET": "${EBAY_CLIENT_SECRET}",
        "EBAY_ENVIRONMENT": "${EBAY_ENVIRONMENT:-production}",
        "EBAY_REDIRECT_URI": "${EBAY_REDIRECT_URI}",
        "EBAY_USER_REFRESH_TOKEN": "${EBAY_USER_REFRESH_TOKEN}"
      }
    },
    "google-sheets": {
      "command": "uvx",
      "args": ["mcp-google-sheets"],
      "env": {
        "SERVICE_ACCOUNT_PATH": "${GOOGLE_SERVICE_ACCOUNT_PATH}",
        "DRIVE_FOLDER_ID": "${GOOGLE_DRIVE_FOLDER_ID}"
      }
    },
    "obsidian": {
      "command": "npx",
      "args": ["-y", "obsidian-mcp-server"],
      "env": {
        "OBSIDIAN_API_KEY": "${OBSIDIAN_API_KEY}",
        "OBSIDIAN_BASE_URL": "${OBSIDIAN_BASE_URL:-http://127.0.0.1:27123}"
      }
    },
    "orcaslicer": {
      "command": "npx",
      "args": ["-y", "mcp-3d-printer-server"],
      "env": {
        "SLICER_TYPE": "orcaslicer",
        "SLICER_PATH": "${ORCASLICER_PATH}",
        "SLICER_PROFILE": "${ORCASLICER_PROFILE}"
      }
    },
    "rescuetime": {
      "command": "uvx",
      "args": ["rescuetime-mcp"],
      "env": {
        "RESCUETIME_API_KEY": "${RESCUETIME_API_KEY}"
      }
    },
    "vultr": {
      "command": "uvx",
      "args": ["mcp-vultr"],
      "env": {
        "VULTR_API_KEY": "${VULTR_API_KEY}"
      }
    }
  }
}
