# MCP Server Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# OFFICIAL FIRST-PARTY MCP SERVERS
# ============================================

# Brave Search (Official)
# Get your API key at: https://brave.com/search/api/
BRAVE_API_KEY=your_brave_api_key

# Cloudflare (Official)
# Create API token at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# Docker Hub (Official)
# Create PAT at: https://hub.docker.com/settings/security
DOCKER_HUB_USERNAME=your_docker_username
DOCKER_HUB_PAT=your_docker_personal_access_token

# Dropbox (Official)
# Create app at: https://www.dropbox.com/developers/apps
DROPBOX_ACCESS_TOKEN=your_dropbox_access_token

# GitHub (Official)
# Create token at: https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token

# Google Chrome DevTools (Official)
# Launch Chrome with: chrome --remote-debugging-port=9222
CHROME_DEBUG_PORT=9222

# Google Drive (Official Reference Implementation)
# Create OAuth credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret

# Gravity Forms (Official - GravityKit)
# Configure in WordPress admin
GRAVITY_FORMS_SITE_URL=https://your-wordpress-site.com
GRAVITY_FORMS_API_KEY=your_gravity_forms_api_key
GRAVITY_FORMS_PRIVATE_KEY=your_gravity_forms_private_key

# HubSpot (Official)
# Create private app at: https://developers.hubspot.com/docs/api/private-apps
HUBSPOT_PRIVATE_APP_TOKEN=your_hubspot_private_app_token

# Make.com (Official)
# Get API key from Make account settings
MAKE_API_KEY=your_make_api_key
MAKE_ZONE=us1
MAKE_TEAM_ID=your_make_team_id

# Notion (Official)
# Create integration at: https://www.notion.so/my-integrations
NOTION_API_KEY=your_notion_api_key

# Portainer (Official)
# Create API key in Portainer settings
PORTAINER_URL=https://your-portainer-instance.com
PORTAINER_API_KEY=your_portainer_api_key

# Sentry (Official)
# Create auth token at: https://sentry.io/settings/auth-tokens/
SENTRY_AUTH_TOKEN=your_sentry_auth_token
SENTRY_ORGANIZATION=your_sentry_organization

# Stripe (Official)
# Get secret key at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Todoist (Official)
# Get API token at: https://todoist.com/prefs/integrations
TODOIST_API_TOKEN=your_todoist_api_token

# WordPress (Official - Automattic)
# Create application password in WordPress user profile
WORDPRESS_URL=https://your-wordpress-site.com
WORDPRESS_USERNAME=your_wordpress_username
WORDPRESS_APPLICATION_PASSWORD=your_wordpress_app_password

# ============================================
# THIRD-PARTY COMMUNITY MCP SERVERS
# ============================================

# FreshBooks (Third-party: roboulos/freshbooks-mcp)
# Create OAuth app at: https://www.freshbooks.com/api/oauth
FRESHBOOKS_CLIENT_ID=your_freshbooks_client_id
FRESHBOOKS_CLIENT_SECRET=your_freshbooks_client_secret
FRESHBOOKS_REDIRECT_URI=http://localhost:3000/callback
FRESHBOOKS_ACCOUNT_ID=your_freshbooks_account_id

# Gmail (Third-party: GongRzhe/Gmail-MCP-Server)
# Uses same Google OAuth credentials as Drive/Calendar
GMAIL_OAUTH_CLIENT_ID=your_google_oauth_client_id
GMAIL_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret

# Google Calendar (Third-party: cocal/google-calendar-mcp)
# Uses same Google OAuth credentials

# Home Assistant (Third-party: allenporter/mcp-server-home-assistant)
# Get long-lived access token from Home Assistant profile
HOME_ASSISTANT_WEB_SOCKET_URL=wss://your-home-assistant-host/api/websocket
HOME_ASSISTANT_API_TOKEN=your_home_assistant_long_lived_token

# Mermaid Chart (Third-party: peng-shawn/mermaid-mcp-server)
# No credentials required - generates diagrams locally

# Monarch Money (Third-party: colvint/monarch-money-mcp)
# WARNING: Uses unofficial API - use at your own risk
MONARCH_EMAIL=your_monarch_email
MONARCH_PASSWORD=your_monarch_password

# n8n (Third-party: leonardsellem/n8n-mcp-server)
# Create API key in n8n settings
N8N_API_KEY=your_n8n_api_key
N8N_BASE_URL=https://your-n8n-instance.com

# pfSense (Third-party: gensecaihq/pfsense-mcp-server)
# Enable API in pfSense system settings
PFSENSE_HOST=https://your-pfsense-host
PFSENSE_USERNAME=admin
PFSENSE_PASSWORD=your_pfsense_password
PFSENSE_VERIFY_SSL=false

# Plex (Third-party: vyb1ng/plex-mcp)
# Get X-Plex-Token from Plex web app network requests
PLEX_URL=http://your-plex-host:32400
PLEX_TOKEN=your_plex_token

# Trello (Third-party: delorenj/mcp-server-trello)
# Get API key at: https://trello.com/app-key
TRELLO_API_KEY=your_trello_api_key
TRELLO_API_TOKEN=your_trello_api_token

# TrueNAS SCALE (Third-party: svnstfns/truenas-mcp-server)
# Create API key in TrueNAS web UI
TRUENAS_HOST=https://your-truenas-host
TRUENAS_API_KEY=your_truenas_api_key

# UniFi Network (Third-party: sirkirby/unifi-network-mcp)
# Use UniFi Network controller credentials
UNIFI_HOST=https://your-unifi-host:8443
UNIFI_USERNAME=your_unifi_username
UNIFI_PASSWORD=your_unifi_password
UNIFI_SITE=default

# WooCommerce (Third-party: techspawn/woocommerce-mcp-server)
# Create REST API keys in WooCommerce settings
WOOCOMMERCE_URL=https://your-store.com
WOOCOMMERCE_CONSUMER_KEY=ck_your_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=cs_your_consumer_secret

# ============================================
# ADDITIONAL MCP SERVERS
# ============================================

# 1Password (Third-party: dkvdm/onepassword-mcp-server)
# Create service account at: https://developer.1password.com/docs/service-accounts/
# WARNING: Educational/proof-of-concept - use with caution
OP_SERVICE_ACCOUNT_TOKEN=ops_your_service_account_token

# Amazon Shopping (Third-party: rigwild/mcp-server-amazon)
# Uses Amazon account credentials - use with caution
AMAZON_EMAIL=your_amazon_email
AMAZON_PASSWORD=your_amazon_password

# AWS (Official - AWS Labs)
# Create access keys at: https://console.aws.amazon.com/iam/
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# eBay (Third-party: YosefHayim/ebay-mcp)
# Create app at: https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=your_ebay_client_id
EBAY_CLIENT_SECRET=your_ebay_client_secret
EBAY_ENVIRONMENT=production
EBAY_REDIRECT_URI=your_ebay_runame
EBAY_USER_REFRESH_TOKEN=your_ebay_refresh_token

# Google Sheets (Third-party: xing5/mcp-google-sheets)
# Create service account at: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_SERVICE_ACCOUNT_PATH=/path/to/service-account.json
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# Obsidian (Third-party: cyanheads/obsidian-mcp-server)
# Requires Obsidian Local REST API plugin: https://github.com/coddingtonbear/obsidian-local-rest-api
OBSIDIAN_API_KEY=your_obsidian_local_rest_api_key
OBSIDIAN_BASE_URL=http://127.0.0.1:27123

# OrcaSlicer / 3D Printer (Third-party: DMontgomery40/mcp-3D-printer-server)
# Supports OrcaSlicer, Bambu, OctoPrint, Klipper, Prusa, etc.
ORCASLICER_PATH=/Applications/OrcaSlicer.app/Contents/MacOS/OrcaSlicer
ORCASLICER_PROFILE=/path/to/your/profile.json

# RescueTime (Third-party: ebowman/rescuetime-mcp)
# Get API key at: https://www.rescuetime.com/anapi/manage
RESCUETIME_API_KEY=your_rescuetime_api_key

# Vultr (Third-party: rsp2k/mcp-vultr)
# Get API key at: https://my.vultr.com/settings/#settingsapi
VULTR_API_KEY=your_vultr_api_key
